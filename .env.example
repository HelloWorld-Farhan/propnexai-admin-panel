# MongoDB Atlas
DATABASE_URL=mongodb+srv://user:password@cluster.mongodb.net/propnex

# Login credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Session cookie encryption (min 32 characters)
ADMIN_SESSION_SECRET=propnex-admin-session-secret-change-in-production-min-32-chars

# Low-credit warning threshold (optional, default 500)
LOW_CREDIT_THRESHOLD=500

# Media server (websocket dialer server)
# Local dev: set PORT only; URL is built as http://localhost:{PORT}
MEDIA_SERVER_PORT=3002
# Production / hosted media server base URL (overrides PORT when set)
MEDIA_SERVER_URL=https://media.your-domain.com
