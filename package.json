{
  "name": "propnex-admin-panel",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3003",
    "build": "prisma generate && next build",
    "start": "next start -p 3000",
    "lint": "eslint",
